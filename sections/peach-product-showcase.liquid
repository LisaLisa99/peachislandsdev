{{ 'peach-showcase.css' | asset_url | stylesheet_tag }}
<div class="section-surface peach-showcase" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --showcase-columns: {{ section.settings.columns }}; --showcase-tablet-columns: {{ section.settings.tablet_columns }}; --showcase-mobile-columns: {{ section.settings.mobile_columns }}; --showcase-gap: {{ section.settings.gap }}px; --showcase-row-gap: {{ section.settings.row_gap }}px; --showcase-ratio: {{ section.settings.image_ratio }}; --showcase-fit: {{ section.settings.image_fit }}; --showcase-align: {{ section.settings.alignment }}">
<div class="container">
  {% if section.settings.heading != blank or section.settings.show_shop_all %}<div class="showcase-heading">{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}{% if section.settings.show_shop_all and section.settings.shop_all_label != blank %}{% assign shop_link = section.settings.shop_all_link | default: section.settings.collection.url | default: routes.all_products_collection_url %}<a class="text-link" href="{{ shop_link }}">{{ section.settings.shop_all_label | escape }}</a>{% endif %}</div>{% endif %}
  <div class="showcase-grid">
  {% if section.settings.source == 'collection' %}
    {% for product in section.settings.collection.products limit: section.settings.product_limit %}
      {% assign alternate_image = nil %}
      {% for block in section.blocks %}{% if block.settings.product.id == product.id and block.settings.image != blank %}{% assign alternate_image = block.settings.image %}{% break %}{% endif %}{% endfor %}
      {% render 'showcase-product', product: product, image: alternate_image, settings: section.settings %}
    {% else %}{% if request.design_mode %}<p class="showcase-setup">{{ 'showcase.choose_collection' | t }}</p>{% endif %}{% endfor %}
  {% else %}
    {% for block in section.blocks %}{% render 'showcase-product', product: block.settings.product, image: block.settings.image, settings: section.settings, block: block %}{% endfor %}
  {% endif %}
  </div>
</div></div>

{% schema %}
{
  "name": "Product showcase",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Peach Islands"
    },
    {
      "type": "checkbox",
      "id": "show_shop_all",
      "label": "Show Shop All link",
      "default": false
    },
    {
      "type": "text",
      "id": "shop_all_label",
      "label": "Shop All label",
      "default": "Shop all"
    },
    {
      "type": "url",
      "id": "shop_all_link",
      "label": "Shop All link",
      "info": "Defaults to the selected collection or all products."
    },
    {
      "type": "select",
      "id": "source",
      "label": "Products",
      "options": [
        {
          "value": "individual",
          "label": "Individual product blocks"
        },
        {
          "value": "collection",
          "label": "Collection"
        }
      ],
      "default": "individual"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Collection product limit",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 6
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop products across",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        },
        {
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "tablet_columns",
      "label": "Tablet products across",
      "options": [
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "3",
          "label": "Three"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile products across",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_names",
      "label": "Show product names",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_prices",
      "label": "Show prices",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_ratings",
      "label": "Show available review ratings",
      "default": false,
      "info": "Requires genuine reviews.rating and reviews.rating_count product metafields. No ratings are generated."
    },
    {
      "type": "checkbox",
      "id": "show_badges",
      "label": "Show sale and sold-out badges",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image proportions",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "contain",
          "label": "Show full image"
        },
        {
          "value": "cover",
          "label": "Fill frame"
        }
      ],
      "default": "contain"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Column spacing",
      "min": 8,
      "max": 64,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Row spacing",
      "min": 8,
      "max": 80,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#111111"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Alternate image",
          "info": "Replaces the image only. Product title, price and destination always come from Shopify. In collection mode this overrides the matching product image."
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Product showcase",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}
