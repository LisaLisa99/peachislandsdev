<article class="container reading"><h1>{{ article.title | escape }}</h1><p>{{ article.published_at | date: '%B %d, %Y' }} · {{ article.author | escape }}</p>{% if article.image %}{{ article.image | image_url: width: 1600 | image_tag: widths: '600, 1000, 1600', sizes: '90vw', loading: 'eager' }}{% endif %}<div class="rte">{{ article.content }}</div><a href="{{ blog.url }}">{{ blog.title | escape }}</a></article><script type="application/ld+json">{{ article | structured_data }}</script>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "settings": [],
  "class": "pi-section"
}
{% endschema %}
