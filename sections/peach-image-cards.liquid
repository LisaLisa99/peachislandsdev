<div class="section-surface image-cards" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px">
<div class="container"><div class="image-card-grid" style="--columns: {{ section.settings.columns }}; --mobile-columns: {{ section.settings.mobile_columns }}; --gap: {{ section.settings.gap }}px; --image-height: {{ section.settings.image_height }}px; --image-fit: {{ section.settings.image_fit }}; --card-title-size: {{ section.settings.heading_size }}px; --card-text-size: {{ section.settings.text_size }}px; --card-text-font: {% if section.settings.text_font == 'secondary' %}var(--secondary-font){% else %}var(--body-font){% endif %}">
{% for block in section.blocks %}<article class="image-card" {{ block.shopify_attributes }}>
{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
{% render 'peach-image', image: block.settings.image, original: block.settings.original_image, alt: block.settings.alt, loading: 'lazy', sizes: '(max-width: 575px) 100vw, (max-width: 991px) 50vw, 33vw' %}
{% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}
{% if block.settings.link != blank %}</a>{% endif %}
<div class="rte">{{ block.settings.text }}</div>
{% render 'image-card-price', block: block, show_prices: section.settings.show_prices %}
{% if block.settings.button_label != blank and block.settings.link != blank %}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
</article>{% endfor %}
</div></div></div>

{% schema %}
{
  "name": "Image and text columns",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Column gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 32,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Desktop image height",
      "min": 120,
      "max": 420,
      "step": 3,
      "default": 294,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "options": [
        {
          "value": "cover",
          "label": "Fill frame"
        },
        {
          "value": "contain",
          "label": "Show full image"
        }
      ],
      "default": "cover"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 20,
      "max": 48,
      "step": 1,
      "default": 29,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "text_font",
      "label": "Text typography",
      "options": [
        {
          "value": "body",
          "label": "Body font"
        },
        {
          "value": "secondary",
          "label": "Secondary card font"
        }
      ],
      "default": "body"
    },
    {
      "type": "checkbox",
      "id": "show_prices",
      "label": "Show prices",
      "default": false
    }
  ],
  "class": "pi-section",
  "blocks": [
    {
      "type": "card",
      "name": "Image card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "original_image",
          "label": "Included original image",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "image_01",
              "label": "APG159b_360x"
            },
            {
              "value": "image_02",
              "label": "BirthMonthFlowers"
            },
            {
              "value": "image_25",
              "label": "EN022-2_fbcb0ac0-a93e-47dd-b111-89b73e79a0b7_"
            },
            {
              "value": "image_33",
              "label": "PEN01-2_300x"
            },
            {
              "value": "image_34",
              "label": "PLA06-4_540x"
            },
            {
              "value": "image_44",
              "label": "TP04-2_1950x"
            },
            {
              "value": "image_45",
              "label": "WP027-S-b_540x"
            }
          ],
          "default": "image_45"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "default": "Peach Islands artwork"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Wrapping Paper"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Beautiful papers designed to turn even the simplest gift into something unforgettable.</p>"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Optional link label"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Optional price text",
          "info": "Shown only when prices are enabled. Leave blank to show no price. Select a product below for automatic pricing instead."
        },
        {
          "type": "product",
          "id": "price_product",
          "label": "Product for automatic price",
          "info": "When selected, its current Shopify price is used instead of the optional price text."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Image and text columns",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}
