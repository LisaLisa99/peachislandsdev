<section class="hero{% if section.settings.image != blank %} hero-with-image{% endif %}">
{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2400 | image_tag: widths: '600, 1000, 1600, 2400', sizes: '100vw', class: 'hero-image', loading: 'eager' }}{% endif %}
<div class="hero-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h1>{{ section.settings.heading | escape }}</h1><div class="hero-text">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div>
</section>
{% schema %}{"name":"Island introduction","settings":[{"type":"image_picker","id":"image","label":"Lifestyle image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"The Peach Islands edit"},{"type":"text","id":"heading","label":"Heading","default":"Find your island state of mind."},{"type":"richtext","id":"text","label":"Description","default":"<p>Discover a world of warm tones, easy moments, and everyday escapes.</p>"},{"type":"text","id":"button_label","label":"Button label","default":"Explore the collection"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Island introduction"}]}{% endschema %}
