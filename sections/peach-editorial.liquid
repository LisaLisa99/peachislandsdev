<div class="section-surface editorial" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px">
<div class="container editorial-grid{% if section.settings.reverse %} editorial-reverse{% endif %}" style="--editorial-height: {{ section.settings.image_height }}px; --editorial-gap: {{ section.settings.gap }}px; --editorial-heading: {{ section.settings.heading_size }}px; --editorial-columns: {{ section.settings.image_columns }}; --button-bg: {{ section.settings.button_color }}">
<div class="editorial-copy"><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="button" href="{{ section.settings.link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>{% endif %}</div>
<div class="editorial-images">{% for block in section.blocks %}<div {{ block.shopify_attributes }}>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}{% render 'peach-image', image: block.settings.image, original: block.settings.original_image, alt: block.settings.alt, loading: 'lazy', sizes: '(max-width: 767px) 100vw, 33vw' %}{% if block.settings.link != blank %}</a>{% endif %}</div>{% endfor %}</div>
</div></div>

{% schema %}
{
  "name": "Story with images",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bringing Beauty to Everyday Moments"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Discover a world of beautifully illustrated journals, stationery, and home accessories.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#238c5a"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 28,
      "max": 64,
      "step": 1,
      "default": 48,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Desktop image height",
      "min": 197,
      "max": 697,
      "step": 5,
      "default": 417,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Column gap",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 28,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_columns",
      "label": "Image columns",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "reverse",
      "label": "Images before text",
      "default": false
    }
  ],
  "class": "pi-section",
  "blocks": [
    {
      "type": "image",
      "name": "Story image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "original_image",
          "label": "Included original image",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "image_32",
              "label": "NaplesTeaTowelPreview"
            },
            {
              "value": "image_34",
              "label": "PLA06-4_540x"
            },
            {
              "value": "image_41",
              "label": "Sample2"
            },
            {
              "value": "image_43",
              "label": "TEA13-4_300x"
            },
            {
              "value": "image_52",
              "label": "calendarsNaples"
            }
          ],
          "default": "image_52"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "default": "Peach Islands artwork"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Story with images",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "image",
          "settings": {
            "original_image": "image_32"
          }
        }
      ]
    }
  ]
}
{% endschema %}
