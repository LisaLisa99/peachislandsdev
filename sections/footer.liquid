<footer class="site-footer" style="--footer-bg: {{ section.settings.background }}; --footer-logo-width: {{ section.settings.logo_width }}px">
<div class="container"><a class="footer-brand" href="{{ routes.root_url }}">{% if section.settings.logo %}{{ section.settings.logo | image_url: width: 1200 | image_tag: widths: '320, 459, 640, 920, 1200', sizes: '(max-width: 749px) 80vw, 460px', alt: shop.name, loading: 'lazy' }}{% else %}<img src="{{ 'PeachIslands.png' | asset_url }}" width="459" height="52" alt="Peach Islands" loading="lazy">{% endif %}</a>
<div class="footer-columns">{% for block in section.blocks %}<div {{ block.shopify_attributes }}><h2>{{ block.settings.heading | escape }}</h2>{% if block.type == 'menu' %}<ul>{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{% else %}{% if block.settings.fallback == 'care' %}{% for policy in shop.policies %}{% if policy.body != blank %}<li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>{% endif %}{% endfor %}{% endif %}{% for page in pages %}{% if block.settings.fallback == 'care' %}{% if page.handle == 'faq' or page.handle == 'freebie-library' %}<li><a href="{{ page.url }}">{{ page.title | escape }}</a></li>{% endif %}{% elsif block.settings.fallback == 'about' %}{% if page.handle == 'about-us' or page.handle == 'our-process' or page.handle == 'contact' %}<li><a href="{{ page.url }}">{{ page.title | escape }}</a></li>{% endif %}{% elsif block.settings.fallback == 'wholesale' %}{% if page.handle == 'wholesale' or page.handle == 'where-to-buy' %}<li><a href="{{ page.url }}">{{ page.title | escape }}</a></li>{% endif %}{% endif %}{% endfor %}{% endfor %}</ul>{% else %}<div class="rte">{{ block.settings.text }}</div>{% endif %}</div>{% endfor %}</div>
<div class="footer-bottom">{% render 'social-links' %}<p>{{ 'now' | date: '%Y' }} {{ shop.name | escape }}®. {{ section.settings.copyright | escape }}</p></div>
</div></footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 160,
      "max": 700,
      "step": 10,
      "default": 460,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#faf7f2"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright text",
      "default": "All rights reserved. See our terms of use and privacy notice."
    }
  ],
  "class": "pi-section",
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Customer care"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "select",
          "id": "fallback",
          "label": "Default store links",
          "options": [
            {
              "value": "care",
              "label": "Policies and customer care"
            },
            {
              "value": "about",
              "label": "About and contact"
            },
            {
              "value": "wholesale",
              "label": "Wholesale"
            }
          ],
          "default": "care"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Goods to inspire and delight"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>We\u2019re an everyday-inspired shop filled with gifts, cards, journals\u2026 and so much more.</p>"
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
