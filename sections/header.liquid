<header class="site-header" style="--logo-width: {{ section.settings.logo_width }}px; --mobile-logo-width: {{ section.settings.mobile_logo_width }}px; --logo-padding: {{ section.settings.logo_padding }}px">
  {% if section.settings.announcement != blank %}<div class="announcement">{{ section.settings.announcement | escape }}</div>{% endif %}
  <div class="header-brand">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
      {% if section.settings.logo != blank %}
        {% assign logo_alt = section.settings.logo.alt | default: shop.name %}
        {{ section.settings.logo | image_url: width: 1600 | image_tag: widths: '200, 320, 460, 640, 920, 1200, 1600', sizes: '(max-width: 749px) 80vw, 600px', alt: logo_alt, class: 'brand-image', loading: 'eager' }}
      {% else %}<span class="brand-name">{{ shop.name | escape }}</span>{% endif %}
    </a>
    <a class="cart-link" href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a>
  </div>
  <nav class="desktop-nav" aria-label="Main navigation">
    <ul>{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% if link.links != blank %}<ul class="nav-children">{% for child in link.links %}<li><a href="{{ child.url }}">{{ child.title | escape }}</a>{% if child.links != blank %}<ul>{% for grandchild in child.links %}<li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li>{% endfor %}</ul>{% endif %}</li>{% endfor %}</ul>{% endif %}</li>{% endfor %}</ul>
  </nav>
  <details class="mobile-nav"><summary>Menu</summary><nav aria-label="Mobile navigation"><ul>{% for link in section.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title | escape }}</a>{% for child in link.links %}<ul><li><a href="{{ child.url }}">{{ child.title | escape }}</a>{% for grandchild in child.links %}<ul><li><a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a></li></ul>{% endfor %}</li></ul>{% endfor %}</li>{% endfor %}</ul></nav></details>
</header>
{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Official logo",
      "info": "Upload the original Peach Islands logo. The image is displayed without cropping, filters, or recoloring."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Desktop logo width",
      "min": 160,
      "max": 600,
      "step": 10,
      "unit": "px",
      "default": 460
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "label": "Mobile logo width",
      "min": 120,
      "max": 320,
      "step": 10,
      "unit": "px",
      "default": 230
    },
    {
      "type": "range",
      "id": "logo_padding",
      "label": "Logo vertical spacing",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "announcement",
      "label": "Announcement",
      "default": "Welcome to Peach Islands"
    }
  ]
}
{% endschema %}
