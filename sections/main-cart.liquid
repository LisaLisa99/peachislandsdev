<section class="content-section reading"><h1>Your bag</h1>{% if cart.empty? %}<p>Your bag is empty.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explore the collection</a>{% else %}<form action="{{ routes.cart_url }}" method="post">{% for item in cart.items %}<div class="cart-row"><a href="{{ item.url }}">{{ item.product.title | escape }} — {{ item.variant.title | escape }}</a><label for="Updates-{{ item.key }}">Quantity</label><input id="Updates-{{ item.key }}" name="updates[]" type="number" min="0" value="{{ item.quantity }}"><span>{{ item.final_line_price | money }}</span><a href="{{ item.url_to_remove }}">Remove</a></div>{% endfor %}<p>Total: {{ cart.total_price | money }}</p><p>Shipping and taxes calculated at checkout.</p><button class="button secondary" name="update" type="submit">Update bag</button><button class="button" name="checkout" type="submit">Checkout</button></form>{% endif %}</section>
{% schema %}{"name":"Cart","settings":[]}{% endschema %}
