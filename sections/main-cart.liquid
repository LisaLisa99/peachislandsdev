<div class="container cart-page"><h1>{{ 'cart.title' | t }}</h1>
{% if cart.empty? %}<p>{{ 'cart.empty' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'general.shop' | t }}</a>
{% else %}<form action="{{ routes.cart_url }}" method="post" id="Cart-{{ section.id }}">
{% for item in cart.items %}<div class="cart-row">
<a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 300 | image_tag: widths: '150, 300', sizes: '140px', alt: item.product.title, loading: 'lazy' }}{% endif %}</a>
<div><a href="{{ item.url }}"><h2>{{ item.product.title | escape }}</h2></a>{% unless item.product.has_only_default_variant %}<p>{{ item.variant.title | escape }}</p>{% endunless %}
{% if item.selling_plan_allocation %}<p>{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{% endif %}
{% for property in item.properties %}{% assign first_character = property.first | slice: 0 %}{% if property.last != blank and first_character != '_' %}<p>{{ property.first | escape }}: {% if property.last contains '/uploads/' %}<a href="{{ property.last }}">{{ property.last | split: '/' | last | escape }}</a>{% else %}{{ property.last | escape }}{% endif %}</p>{% endif %}{% endfor %}
{% for discount in item.line_level_discount_allocations %}<p>{{ discount.discount_application.title | escape }} (−{{ discount.amount | money }})</p>{% endfor %}
<a class="text-link" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a></div>
<div><label for="Update-{{ section.id }}-{{ forloop.index }}">{{ 'product.quantity' | t }}</label><input id="Update-{{ section.id }}-{{ forloop.index }}" name="updates[]" type="number" min="0" step="{{ item.variant.quantity_rule.increment | default: 1 }}"{% if item.variant.quantity_rule.max %} max="{{ item.variant.quantity_rule.max }}"{% endif %} value="{{ item.quantity }}"></div><div>{% if item.original_line_price != item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}<p>{{ item.final_line_price | money }}</p>{% if item.unit_price_measurement %}<small>{{ item.unit_price | money }} / {{ item.unit_price_measurement.reference_value }}{{ item.unit_price_measurement.reference_unit }}</small>{% endif %}</div>
</div>{% endfor %}
<div class="cart-summary"><label for="CartNote-{{ section.id }}">{{ 'cart.note' | t }}</label><textarea id="CartNote-{{ section.id }}" name="note">{{ cart.note | escape }}</textarea>
{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }}: −{{ discount.total_allocated_amount | money }}</p>{% endfor %}
<p class="cart-total">{{ 'cart.total' | t }}: {{ cart.total_price | money_with_currency }}</p><p>{{ 'cart.shipping' | t }}</p><button class="button secondary" type="submit" name="update">{{ 'cart.update' | t }}</button><button class="button" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button></div>
</form>{% endif %}</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [],
  "class": "pi-section"
}
{% endschema %}
