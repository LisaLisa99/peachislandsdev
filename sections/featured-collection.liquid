<section class="content-section"><div class="section-title"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div><div class="product-grid">{% for product in section.settings.collection.products limit: section.settings.product_limit %}{% render 'product-card', product: product %}{% else %}<p class="empty-state">Our next chapter is on its way. Explore the collection soon.</p>{% endfor %}</div></section>
{% schema %}{"name":"Featured collection","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Thoughtfully selected"},{"type":"text","id":"heading","label":"Heading","default":"Island favorites"},{"type":"collection","id":"collection","label":"Collection"},{"type":"range","id":"product_limit","label":"Products to show","min":4,"max":12,"step":4,"default":4}],"presets":[{"name":"Featured collection"}]}{% endschema %}
