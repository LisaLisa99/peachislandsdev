<div class="split-hero section-surface" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px" >
<div class="hero-grid" style="--hero-height: {{ section.settings.height }}px; --mobile-height: {{ section.settings.mobile_height }}px; --hero-columns: {{ section.settings.columns }}; --hero-gap: {{ section.settings.gap }}px">
{% for block in section.blocks %}<article class="hero-panel" {{ block.shopify_attributes }} style="--overlay: {{ block.settings.overlay | divided_by: 100.0 }}; --title-size: {{ block.settings.heading_size }}px; --button-bg: {{ block.settings.button_color }}; --hero-position: {{ block.settings.position }}">
{% render 'peach-image', image: block.settings.image, original: block.settings.original_image, alt: block.settings.alt, loading: 'eager', sizes: '(max-width: 991px) 100vw, 50vw' %}
<div class="hero-shade"></div><div class="hero-content"><h2>{{ block.settings.heading | escape }}</h2>{% if block.settings.button_label != blank %}<a class="button" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>{% endif %}</div>
</article>{% endfor %}
</div></div>

