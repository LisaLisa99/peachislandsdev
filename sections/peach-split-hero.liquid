<div class="split-hero section-surface" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px" >
<div class="hero-grid" style="--hero-height: {{ section.settings.height }}px; --mobile-height: {{ section.settings.mobile_height }}px; --hero-columns: {{ section.settings.columns }}; --hero-gap: {{ section.settings.gap }}px">
{% for block in section.blocks %}<article class="hero-panel" {{ block.shopify_attributes }} style="--overlay: {{ block.settings.overlay | divided_by: 100.0 }}; --title-size: {{ block.settings.heading_size }}px; --button-bg: {{ block.settings.button_color }}; --hero-position: {{ block.settings.position }}">
{% render 'peach-image', image: block.settings.image, original: block.settings.original_image, alt: block.settings.alt, loading: 'eager', sizes: '(max-width: 991px) 100vw, 50vw' %}
<div class="hero-shade"></div><div class="hero-content"><h2>{{ block.settings.heading | escape }}</h2>{% if block.settings.button_label != blank %}<a class="button" href="{{ block.settings.link | default: routes.all_products_collection_url }}">{{ block.settings.button_label | escape }}</a>{% endif %}</div>
</article>{% endfor %}
</div></div>

{% schema %}
{
  "name": "Split image hero",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Desktop image height",
      "min": 297,
      "max": 897,
      "step": 6,
      "default": 597,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile image height",
      "min": 240,
      "max": 600,
      "step": 4,
      "default": 352,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",
      "options": [
        {
          "value": "1",
          "label": "One"
        },
        {
          "value": "2",
          "label": "Two"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Image gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 0,
      "unit": "px"
    }
  ],
  "class": "pi-section",
  "blocks": [
    {
      "type": "panel",
      "name": "Image panel",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "original_image",
          "label": "Included original image",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "image_25",
              "label": "EN022-2_fbcb0ac0-a93e-47dd-b111-89b73e79a0b7_"
            },
            {
              "value": "image_26",
              "label": "IMG_9979-2_540x"
            }
          ],
          "default": "image_25"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image description",
          "default": "Peach Islands artwork"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Desk & Stationary"
        },
        {
          "type": "range",
          "id": "heading_size",
          "label": "Heading size",
          "min": 28,
          "max": 80,
          "step": 1,
          "default": 61,
          "unit": "px"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "Button color",
          "default": "#dea08d"
        },
        {
          "type": "range",
          "id": "overlay",
          "label": "Image shading",
          "min": 0,
          "max": 60,
          "step": 1,
          "default": 0,
          "unit": "%"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Text position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Split image hero",
      "blocks": [
        {
          "type": "panel"
        },
        {
          "type": "panel",
          "settings": {
            "original_image": "image_26",
            "heading": "Wrapping Paper",
            "position": "center"
          }
        }
      ]
    }
  ]
}
{% endschema %}
