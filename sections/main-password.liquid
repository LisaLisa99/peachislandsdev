<a href="{{ routes.root_url }}"><img src="{{ 'PeachIslands.png' | asset_url }}" width="459" height="52" alt="Peach Islands"></a><h1>{{ shop.name | escape }}</h1><div class="rte">{{ shop.password_message }}</div>{% form 'storefront_password' %}{{ form.errors | default_errors }}<label for="Password-{{ section.id }}">{{ 'password.label' | t }}</label><input id="Password-{{ section.id }}" type="password" name="password" required><button class="button" type="submit">{{ 'password.enter' | t }}</button>{% endform %}

{% schema %}
{
  "name": "Password",
  "tag": "section",
  "settings": [],
  "class": "pi-section"
}
{% endschema %}
