{{ 'peach-wide-columns.css' | asset_url | stylesheet_tag }}
<div class="section-surface image-cards peach-wide-columns" style="--section-bg: {{ section.settings.background }}; --section-ink: {{ section.settings.text_color }}; --pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px; --wide-columns: 5; --tablet-columns: {{ section.settings.tablet_columns }}; --mobile-columns: {{ section.settings.mobile_columns }}; --gap: {{ section.settings.gap }}px; --row-gap: {{ section.settings.row_gap }}px; --image-height: {{ section.settings.image_height }}px; --tablet-image-height: {{ section.settings.tablet_image_height }}px; --mobile-image-height: {{ section.settings.mobile_image_height }}px; --image-fit: {{ section.settings.image_fit }}; --card-title-size: {{ section.settings.heading_size }}px; --card-text-size: {{ section.settings.text_size }}px; --card-text-font: {% if section.settings.text_font == 'secondary' %}var(--secondary-font){% else %}var(--body-font){% endif %}; --card-alignment: {{ section.settings.alignment }}">
  <div class="container">
    {% render 'peach-row-header', settings: section.settings, inset: true %}
    <div class="image-card-grid">
      {% for block in section.blocks %}
        <article class="image-card" {{ block.shopify_attributes }} style="--column-image-width: {{ block.settings.image_width }}%;{% unless block.settings.alignment == 'inherit' %} --card-alignment: {{ block.settings.alignment }};{% endunless %}">
          {% if block.settings.link != blank %}<a class="column-image-link" href="{{ block.settings.link }}">{% endif %}
          <div class="column-image">{% render 'peach-image', image: block.settings.image, original: block.settings.original_image, alt: block.settings.alt, loading: 'lazy', sizes: '(max-width: 575px) 100vw, (max-width: 991px) 50vw, 20vw' %}</div>
          {% if block.settings.link != blank %}</a>{% endif %}
          {% if block.settings.heading != blank %}<h2>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}{{ block.settings.heading | escape }}{% if block.settings.link != blank %}</a>{% endif %}</h2>{% endif %}
          <div class="rte">{{ block.settings.text }}</div>
{% render 'image-card-price', block: block, show_prices: section.settings.show_prices %}
          {% if block.settings.link != blank and block.settings.button_label != blank %}<a class="text-link" href="{{ block.settings.link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</div>

