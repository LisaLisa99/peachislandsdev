<article class="product-card">
<a href="{{ product.url }}">
{% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | image_tag: widths: '300, 500, 750, 1000', sizes: '(max-width: 575px) 50vw, 25vw', loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'pi-placeholder' }}{% endif %}
<h2>{{ product.title | escape }}</h2></a>
{% if product.metafields.custom.subtitle != blank %}<p>{{ product.metafields.custom.subtitle | escape }}</p>{% elsif product.type != blank %}<p>{{ product.type | escape }}</p>{% endif %}
<p class="card-price">{% if product.price_varies %}{{ 'product.from' | t }} {% endif %}{{ product.price | money }}{% if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif %}{% unless product.available %}<span class="sold-out">{{ 'product.sold_out' | t }}</span>{% endunless %}</p>
</article>
