<article class="product-card"><a href="{{ product.url }}">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: widths: '300, 500, 800', sizes: '(max-width: 749px) 45vw, 25vw', loading: 'lazy' }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'placeholder' }}{% endif %}<h3>{{ product.title | escape }}</h3><p>{{ product.price | money }}{% unless product.available %} · Sold out{% endunless %}</p></a></article>
