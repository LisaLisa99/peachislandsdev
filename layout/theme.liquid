<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title | escape }}{% if current_tags %} — {{ current_tags | join: ', ' | escape }}{% endif %}{% if current_page != 1 %} — Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  {% if request.page_type == 'product' %}<meta property="og:type" content="product">{% else %}<meta property="og:type" content="website">{% endif %}
  {% if page_image %}<meta property="og:image" content="https:{{ page_image | image_url: width: 1200 }}">{% endif %}
  {% if settings.favicon %}<link rel="icon" href="{{ settings.favicon | image_url: width: 32 }}">{% endif %}
  {% render 'header-fonts' %}
  {% style %}
    {{ settings.heading_font | font_face: font_display: 'swap' }}
    {{ settings.body_font | font_face: font_display: 'swap' }}
    {{ settings.nav_font | font_face: font_display: 'swap' }}
    {{ settings.secondary_font | font_face: font_display: 'swap' }}
    :root { --secondary-font: {{ settings.secondary_font.family | default: 'Open Sans' }}, {{ settings.secondary_font.fallback_families | default: 'sans-serif' }}; --heading-font: {% if settings.use_original_heading_font %}'Peach Islands Cormorant Garamond', serif{% else %}{{ settings.heading_font.family | default: 'serif' }}, {{ settings.heading_font.fallback_families | default: 'serif' }}{% endif %}; --body-font: {{ settings.body_font.family | default: 'Peach Islands Montserrat' }}, {{ settings.body_font.fallback_families | default: 'sans-serif' }}; --nav-font: {{ settings.nav_font.family | default: 'Peach Islands Montserrat' }}, {{ settings.nav_font.fallback_families | default: 'sans-serif' }}; --ink: {{ settings.text_color }}; --green: {{ settings.button_color }}; --blush: {{ settings.blush_color }}; --cream: {{ settings.cream_color }}; --rose: {{ settings.accent_color }}; --page-width: {{ settings.page_width }}px; }
  {% endstyle %}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {{ content_for_header }}
</head>
<body>
  <a class="skip-link" href="#MainContent">{{ 'general.skip' | t }}</a>
  {% sections 'header-group' %}
  <main id="MainContent" tabindex="-1">{% if request.page_type == 'index' %}<h1 class="visually-hidden">{{ shop.name | escape }}</h1>{% endif %}{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
</body>
</html>
