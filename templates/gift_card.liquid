{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ shop.name | escape }} — {{ 'gift_card.title' | t }}</title>{{ content_for_header }}{{ 'theme.css' | asset_url | stylesheet_tag }}</head>
<body><main class="container reading">
<a href="{{ shop.url }}"><img src="{{ 'PeachIslands.png' | asset_url }}" width="459" height="52" alt="Peach Islands"></a>
<h1>{{ 'gift_card.title' | t }}</h1>
<p>{{ gift_card.initial_value | money_with_currency }}</p>
<p>{{ 'gift_card.balance' | t }}: {{ gift_card.balance | money_with_currency }}</p>
{% if gift_card.enabled == false %}<p>{{ 'gift_card.disabled' | t }}</p>{% elsif gift_card.expired %}<p>{{ 'gift_card.expired' | t }}</p>{% else %}<p>{{ 'gift_card.code' | t }}: <strong>{{ gift_card.code | format_code }}</strong></p>{% endif %}
{% if gift_card.expires_on %}<p>{{ 'gift_card.expires' | t }}: {{ gift_card.expires_on | date: '%B %d, %Y' }}</p>{% endif %}
{% if gift_card.pass_url %}<p><a href="{{ gift_card.pass_url }}">{{ 'gift_card.wallet' | t }}</a></p>{% endif %}
<p><a class="button" href="{{ shop.url }}">{{ 'general.shop' | t }}</a></p>
</main></body></html>
